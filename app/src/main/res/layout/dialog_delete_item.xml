<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SELECT MENU ITEM"
        android:gravity="center"
        android:textColor="#5D606B"
        android:textStyle="bold"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:background="@drawable/input_background">

        <TextView
            android:id="@+id/deleteItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Greek Salad"
            android:textColor="#15151D"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/deleteItemCoursePrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Starter · R65.00"
            android:textColor="#8B3B0D"
            android:textSize="17sp" />

    </LinearLayout>

    <TextView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:text="⚠"
        android:textColor="#B51E25"
        android:textSize="32sp"
        android:background="@drawable/warning_circle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:text="Are you sure you want to delete this item?"
        android:textColor="#15151D"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="This action cannot be undone."
        android:textColor="#666873"
        android:textSize="17sp" />

    <Button
        android:id="@+id/confirmDeleteButton"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="34dp"
        android:backgroundTint="#D71920"
        android:text="[Delete]"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/cancelDeleteButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#E5E5E7"
        android:text="[Cancel]"
        android:textAllCaps="false"
        android:textColor="#20202A"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
